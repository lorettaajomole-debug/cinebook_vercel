# Neon Serverless PostgreSQL / Database Pooled URL
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-1.aws.neon.tech/cinebook?sslmode=require"

# Direct URL for migrations (if required by Neon)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-1.aws.neon.tech/cinebook?sslmode=require"

# Authentication Secret
JWT_SECRET="generate_a_random_32_character_string_for_production"

# Vercel Cron Secret (protects /api/cron/release-holds)
CRON_SECRET="generate_a_random_cron_secret"

# Payment Engine Mode (test or production)
PAYMENT_PROVIDER_MODE="test"

# Application URL
NEXT_PUBLIC_APP_URL="https://cinebook.vercel.app"
